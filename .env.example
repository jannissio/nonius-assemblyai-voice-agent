# The existing ASEEMBLYAI_API_KEY and assembly.ai.api spellings also work.
ASSEMBLYAI_API_KEY=
NONIUS_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Use a password for restricted hosting, or explicitly opt into capped public live access.
NONIUS_DEMO_PASSWORD=
PORT=4317
HOST=127.0.0.1
# Interviews include speaker diarization (+$0.12/hour); voice commands do not.
# No other paid add-ons or automatic fallback to another model.
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_LLM_MODEL=qwen3.5-4b-32k-fast
NONIUS_BUDGET_USD=2
NONIUS_MAX_SESSION_SECONDS=180
NONIUS_MAX_AUDIO_SECONDS=1800
NONIUS_MAX_LLM_CALLS=80
NONIUS_LLM_COOLDOWN_SECONDS=35

# Hosted mode settings belong in the hosting provider's secret/config manager.
# Keep the sample default until the persistent database is verified.
NONIUS_HOSTED_MODE=sample
NONIUS_PUBLIC_LIVE=false
DATABASE_URL=
# US-dollar reservation ceilings; daily reset uses an IANA timezone.
NONIUS_DAILY_BUDGET_USD=1
NONIUS_BUDGET_TIMEZONE=Europe/Berlin
